{
  "name": "@yunhozz/arc",
  "version": "0.1.8",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/node/*.test.mjs",
    "build:native": "node scripts/build-native.mjs",
    "check:manifest": "node scripts/update-manifest.mjs --check",
    "update:role-policy": "node scripts/update-role-policy.mjs",
    "check:role-policy": "node scripts/update-role-policy.mjs --check",
    "pack:release": "node scripts/pack-release.mjs"
  },
  "devDependencies": {
    "node-gyp": "11.5.0",
    "smol-toml": "1.9.1"
  },
  "bin": {
    "arc": "bin/arc.mjs"
  },
  "files": [
    "bin/",
    "lib/",
    "scripts/",
    "vendor/",
    "prebuilds/",
    "native/binding.c",
    "native/binding.gyp",
    "codex/skill/",
    "codex/agents/",
    "claude/skill/",
    "claude/agents/",
    "MANIFEST.sha256",
    "install.command",
    "!**/__pycache__/**",
    "!**/*.pyc"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yunhozz/arc.git"
  }
}
